{
  "name": "axion-interventions",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run db:migrate && bun node_modules/next/dist/bin/next dev",
    "build": "bun node_modules/next/dist/bin/next build",
    "start": "bun scripts/validate-production-env.ts && bun node_modules/next/dist/bin/next start",
    "test": "bun test",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun test && bun run build",
    "db:generate": "drizzle-kit generate",
    "auth:schema": "bunx auth@latest generate --config scripts/better-auth.cli.ts --adapter drizzle --dialect sqlite --output db/better-auth.generated.ts --yes",
    "db:migrate": "bun scripts/prepare-db.ts && drizzle-kit migrate && bun scripts/seed-demo.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "latest",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
